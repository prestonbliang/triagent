# ---- Triagent configuration (copy to .env) ----
# Everything has a safe offline default; set these only for production runs.

# LLM provider: "fake" (deterministic, offline), "openai", or "anthropic"
TRIAGENT_LLM_PROVIDER=fake
TRIAGENT_LLM_MODEL=gpt-4o-mini
TRIAGENT_REASONING_MODEL=gpt-4o          # used by scoring + critic agents
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Embeddings: "fake" (hash, offline) or "sentence-transformers"
TRIAGENT_EMBEDDER=fake
TRIAGENT_EMBED_MODEL=BAAI/bge-small-en-v1.5
TRIAGENT_EMBED_DIM=384

# Reranker: "off", "identity", or "cross-encoder"
TRIAGENT_RERANKER=identity
TRIAGENT_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Vector store: "memory" (offline default) or "pgvector"
TRIAGENT_STORE=memory
TRIAGENT_DATABASE_URL=postgresql+psycopg://triagent:triagent@localhost:5432/triagent

# NVD ingestion (https://nvd.nist.gov/developers/request-an-api-key)
# Without a key you are rate-limited to 5 requests / 30s. With one, 50 / 30s.
# NVD_API_KEY=

# Observability (optional Langfuse tracing)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# Retrieval / triage tuning
TRIAGENT_RETRIEVAL_K=20
TRIAGENT_RERANK_K=6
TRIAGENT_DUP_THRESHOLD=0.83
TRIAGENT_MAX_REVISIONS=2
